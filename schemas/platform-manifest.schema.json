{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dot.brain/schemas/platform-manifest.schema.json",
  "title": "DKP Platform Registration Manifest (platform.dkp.json)",
  "type": "object",
  "required": ["platform", "display_name", "dkp_version", "endpoints", "keys", "contacts"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "platform": { "type": "string", "pattern": "^dot-[a-z0-9-]+$" },
    "display_name": { "type": "string" },
    "dkp_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "endpoints": {
      "type": "object",
      "required": ["publish_topic", "response_topic", "pr_repository"],
      "properties": {
        "publish_topic": { "type": "string" },
        "response_topic": { "type": "string" },
        "pr_repository": { "type": "string", "description": "Repository that receives Dot.Brain PRs" }
      }
    },
    "keys": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "algorithm", "public_key", "valid_from"],
        "additionalProperties": false,
        "properties": {
          "key_id": { "type": "string" },
          "algorithm": { "const": "ed25519" },
          "public_key": { "type": "string", "contentEncoding": "base64" },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_to": { "type": "string", "format": "date-time" }
        }
      }
    },
    "advisory_subscriptions": {
      "type": "array",
      "items": { "enum": ["security", "reliability", "performance", "workflow", "business", "all"] },
      "default": ["all"]
    },
    "rate_limit_per_minute": { "type": "integer", "minimum": 1, "default": 100 },
    "contacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "handle"],
        "properties": {
          "role": { "type": "string" },
          "handle": { "type": "string" }
        }
      }
    }
  }
}
