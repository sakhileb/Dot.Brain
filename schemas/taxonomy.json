  "change_log": [
    { "version": "1.0.0", "date": "2026-08-01", "author": "DKP Architect (prompt 02, AI)", "change": "Initial machine-readable root: 14 domain subtrees seeded from published platform docs; four frozen terms (>= 2 consumers); worked SAME_AS mapping carried from brain.semantic.md §6" }
  ]
